{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Church Audio Intelligence",
  "version": "0.2.28",
  "identifier": "org.hkm.church-audio-intelligence",
  "build": {
    "beforeDevCommand": "node scripts/tauri-dev-server.mjs",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Church Audio Intelligence",
        "width": 1240,
        "height": 680,
        "minWidth": 860,
        "minHeight": 540,
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "devCsp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "object-src": "'none'",
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "ws://127.0.0.1:*", "ws://localhost:*", "ws:", "https://github.com", "https://*.githubusercontent.com"],
        "font-src": ["'self'", "https://fonts.gstatic.com", "data:"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "data:", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com"],
        "script-src": "'self'"
      },
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "object-src": "'none'",
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "ws://127.0.0.1:*", "ws://localhost:*", "ws:", "https://github.com", "https://*.githubusercontent.com"],
        "font-src": ["'self'", "https://fonts.gstatic.com", "data:"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "data:", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com"],
        "script-src": "'self'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4NUYxMjU3NDA4MUVFRjUKUldUMTdvRkFWeEpmK0xkTjJHbHpRVkU1ZG9xNTBFdmpnMWNldWxIQjczcmlhRXNYaXFZM3hocmkK",
      "endpoints": [
        "https://github.com/abazionkiai/HKM-AUDIO-SYSTEM/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Church audio control and signal analysis"
  }
}
